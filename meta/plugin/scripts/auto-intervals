#!/bin/bash
# Sourced by scripts/start (and the packaging tests); defines no side effects.
#
# Hardware-gated collectors accept INTERVAL_<X>="auto" (#261): the daemon then
# keeps the collector off while its hardware is absent and enables it at
# 5 minutes once the hardware is detected. Any other value, including "0"
# (Disabled), is an explicit choice the daemon never changes.

# AUTO_INTERVAL_KEYS pairs each config key with its collector name.
AUTO_INTERVAL_KEYS="INTERVAL_PSU:psu INTERVAL_NIC:nic INTERVAL_STORAGE_TOPOLOGY:storage_topology INTERVAL_GPU:gpu INTERVAL_UPS:ups INTERVAL_NUT:nut INTERVAL_ZFS:zfs"

# resolve_auto_intervals rewrites every "auto" interval to 0 and lists its
# collector in UNRAID_AUTO_COLLECTORS (comma-separated). Numeric values are
# left unchanged for sanitize_int.
resolve_auto_intervals() {
    local pair key name value
    UNRAID_AUTO_COLLECTORS=""
    for pair in $AUTO_INTERVAL_KEYS; do
        key="${pair%%:*}"
        name="${pair#*:}"
        value="${!key-}"
        if [ "$value" = "auto" ]; then
            printf -v "$key" '%s' 0
            UNRAID_AUTO_COLLECTORS="${UNRAID_AUTO_COLLECTORS:+${UNRAID_AUTO_COLLECTORS},}${name}"
        fi
    done
}
