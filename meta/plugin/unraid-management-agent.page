<script>
// Service control via AJAX
function serviceControl(action) {
    var btn = document.getElementById('uma-btn-startstop');
    var restartBtn = document.getElementById('uma-btn-restart');
    btn.disabled = true;
    restartBtn.disabled = true;
    btn.value = action === 'stop' ? 'Stopping...' : action === 'start' ? 'Starting...' : 'Restarting...';

    $.post('/plugins/<?=$plugin?>/include/exec.php', {action: action}, function() {
        // Don't trust the immediate response — confirm with a status poll
        setTimeout(pollStatus, 2500);
    }, 'json').fail(function() {
        setTimeout(pollStatus, 3000);
    });
}

function pollStatus() {
    $.post('/plugins/<?=$plugin?>/include/exec.php', {action: 'status'}, function(data) {
        var running = (data.running === true || data.running === 'true');
        updateServiceStatus(running);
    }, 'json').fail(function() {
        location.reload();
    });
}

function updateServiceStatus(running) {
    var statusOrb = document.getElementById('uma-status-orb');
    var statusText = document.getElementById('uma-status-text');
    var btn = document.getElementById('uma-btn-startstop');
    var restartBtn = document.getElementById('uma-btn-restart');
    var endpoints = document.getElementById('uma-endpoints');

    // The diagnostics tools need the service running; keep them in sync with it.
    var dlBtn = document.getElementById('uma-download-diag');
    var stBtn = document.getElementById('uma-selftest-btn');
    if (dlBtn) dlBtn.disabled = !running;
    if (stBtn) stBtn.disabled = !running;

    if (running) {
        statusOrb.className = 'fa fa-circle green-orb';
        statusText.textContent = 'RUNNING';
        statusText.className = 'uma-status-text running';
        btn.value = 'Stop';
        btn.onclick = function() { serviceControl('stop'); };
        btn.disabled = false;
        restartBtn.disabled = false;
        endpoints.style.display = 'block';
    } else {
        statusOrb.className = 'fa fa-circle grey-orb';
        statusText.textContent = 'STOPPED';
        statusText.className = 'uma-status-text stopped';
        btn.value = 'Start';
        btn.onclick = function() { serviceControl('start'); };
        btn.disabled = false;
        restartBtn.disabled = true;
        endpoints.style.display = 'none';
    }
}

// Toggle MQTT fields visibility
function toggleMQTTFields() {
    var enabled = document.getElementById('mqtt_enabled').checked;
    document.getElementById('mqtt_fields').style.display = enabled ? 'block' : 'none';
    document.getElementById('mqtt_enabled_val').value = enabled ? 'true' : 'false';
}

function updateMQTTHA() {
    var enabled = document.getElementById('mqtt_ha_enabled').checked;
    document.getElementById('mqtt_ha_val').value = enabled ? 'true' : 'false';
}

function updateReadOnly() {
    var enabled = document.getElementById('read_only').checked;
    document.getElementById('read_only_val').value = enabled ? 'true' : 'false';
    var banner = document.getElementById('uma-policy-ro-banner');
    if (banner) {
        banner.style.display = enabled ? 'block' : 'none';
    }
}

function updateDebugLogging() {
    var enabled = document.getElementById('debug_logging').checked;
    document.getElementById('log_level_val').value = enabled ? 'debug' : 'info';
}

function umaEscapeHtml(s) {
    return String(s).replace(/[&<>"']/g, function(c) {
        return {'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'}[c];
    });
}

function umaStateClass(state) {
    if (state === 'healthy') return 'uma-st-ok';
    if (state === 'degraded') return 'uma-st-warn';
    return 'uma-st-bad';
}

// Download the redacted diagnostics ZIP via a same-origin top-level link click
// to the PHP proxy, which streams the agent's bundle as an attachment.
// Same-origin is the only download path that works in every browser: reaching
// the agent's own port directly is cross-origin, which Safari blocks for
// downloads and which is mixed-content on an HTTPS webGUI.
function downloadDiagnostics() {
    var a = document.createElement('a');
    a.href = '/plugins/<?=$plugin?>/include/diagnostics.php?action=download';
    a.download = '';
    document.body.appendChild(a);
    a.click();
    a.remove();
}

function runSelfTest() {
    var btn = document.getElementById('uma-selftest-btn');
    var out = document.getElementById('uma-selftest-result');
    var orig = btn.value;
    btn.disabled = true;
    btn.value = 'Running…';
    out.style.display = 'block';
    out.textContent = 'Running self-test…';
    $.post('/plugins/<?=$plugin?>/include/diagnostics.php', {action: 'selftest'}, function(data) {
        renderSelfTest(out, data);
    }, 'json').fail(function(xhr) {
        var msg = (xhr.responseJSON && xhr.responseJSON.error) ? xhr.responseJSON.error : 'could not reach the agent';
        out.innerHTML = '<span class="uma-st-bad">Self-test failed:</span> ' + umaEscapeHtml(msg);
    }).always(function() {
        btn.disabled = false;
        btn.value = orig;
    });
}

function renderSelfTest(out, data) {
    if (!data || typeof data !== 'object') {
        out.innerHTML = '<span class="uma-st-bad">Self-test returned no data.</span>';
        return;
    }
    var caps = (data.capabilities && Array.isArray(data.capabilities.items)) ? data.capabilities.items : [];
    var capsOk = caps.filter(function(c) { return c.available; }).length;
    var subs = Array.isArray(data.subsystems) ? data.subsystems : [];
    var html = '';
    html += '<div class="uma-st-row"><span>Unraid version</span><span>' + umaEscapeHtml(data.unraid_version || 'unknown') + '</span></div>';
    html += '<div class="uma-st-row"><span>Overall data-source health</span><span class="' + umaStateClass(data.overall_state) + '">' + umaEscapeHtml(data.overall_state || 'unknown') + '</span></div>';
    html += '<div class="uma-st-row"><span>Capabilities available</span><span>' + capsOk + ' / ' + caps.length + '</span></div>';
    if (subs.length) {
        html += '<div class="uma-st-heading">Subsystems</div>';
        subs.forEach(function(s) {
            html += '<div class="uma-st-row"><span>' + umaEscapeHtml(s.subsystem || '?') + '</span><span class="' + umaStateClass(s.state) + '">' + umaEscapeHtml(s.state || '?') + '</span></div>';
        });
    }
    out.innerHTML = html;
}

// Unraid enables the form's Apply button on "input"/"change" events, which
// browsers don't fire when a script sets a field's value. Fire one so changes
// made by Generate/Clear can be applied.
function markFieldChanged(field) {
    if (field) {
        field.dispatchEvent(new Event('change', { bubbles: true }));
    }
}

// The saved token is never sent back to the page, so Show/Copy only have
// something to act on after a token was generated or typed in.
function updateTokenButtons() {
    var field = document.getElementById('api_token');
    if (!field) return;
    var empty = field.value === '';
    var hint = empty ? 'The saved token is not displayed. Generate a new token (then Apply) to see or copy it.' : '';
    ['uma-btn-token-toggle', 'uma-btn-token-copy'].forEach(function(id) {
        var btn = document.getElementById(id);
        if (btn) {
            btn.disabled = empty;
            btn.title = hint;
        }
    });
}

function toggleTokenVisibility() {
    var field = document.getElementById('api_token');
    var btn = document.getElementById('uma-btn-token-toggle');
    if (field.type === 'password') {
        field.type = 'text';
        btn.value = 'Hide';
    } else {
        field.type = 'password';
        btn.value = 'Show';
    }
}

function generateToken() {
    var array = new Uint8Array(32);
    window.crypto.getRandomValues(array);
    var token = Array.from(array, function(b) {
        return ('0' + b.toString(16)).slice(-2);
    }).join('');
    var field = document.getElementById('api_token');
    field.type = 'text';
    field.value = token;
    document.getElementById('uma-btn-token-toggle').value = 'Hide';
    document.getElementById('api_token_clear').value = '0';
    markFieldChanged(field);
    updateTokenButtons();
    updateMcpOnboardingUI();
}

function copyToken() {
    var field = document.getElementById('api_token');
    var val = field.value;
    if (!val) {
        return;
    }
    var markCopied = function() {
        var btn = document.getElementById('uma-btn-token-copy');
        if (!btn) return;
        var orig = btn.value;
        btn.value = 'Copied!';
        btn.disabled = true;
        setTimeout(function() {
            btn.value = orig;
            btn.disabled = false;
        }, 2000);
    };

    if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(val).then(markCopied).catch(function() {
            fallbackCopy(field, markCopied);
        });
    } else {
        fallbackCopy(field, markCopied);
    }
}

function fallbackCopy(field, callback) {
    var prevType = field.type;
    field.type = 'text';
    field.select();
    field.setSelectionRange(0, 99999);
    try {
        var successful = document.execCommand('copy');
        if (successful && callback) callback();
    } catch (e) {
        // ignore
    }
    field.type = prevType;
}

function clearToken() {
    var field = document.getElementById('api_token');
    field.value = '';
    field.placeholder = 'No authentication (disabled)';
    document.getElementById('api_token_clear').value = '1';
    var clearBtn = document.getElementById('uma-btn-token-clear');
    if (clearBtn) {
        clearBtn.style.display = 'none';
    }
    markFieldChanged(field);
    updateTokenButtons();
    updateMcpOnboardingUI();
}

// Highlight disabled interval selects
function updateDisabledHighlighting() {
    document.querySelectorAll('.uma-interval-select').forEach(function(select) {
        if (select.value === '0') {
            select.classList.add('is-disabled');
        } else {
            select.classList.remove('is-disabled');
        }
    });
}

// MCP Tool Policy Management
var umaToolCatalog = [];
var umaActivePolicies = <?= $tool_policy_json ?: '{}' ?>;
var umaToolCatalogLoaded = false;

function toggleToolPolicyPanel() {
    var panel = document.getElementById('uma-tool-policy-panel');
    if (!panel) return;
    if (panel.style.display === 'none') {
        panel.style.display = 'block';
        if (!umaToolCatalogLoaded) {
            loadToolCatalog();
        }
    } else {
        panel.style.display = 'none';
    }
}

function loadToolCatalog() {
    var tbody = document.getElementById('uma-tool-policy-tbody');
    tbody.innerHTML = '<tr><td colspan="5" style="padding:20px; text-align:center; color:gray;"><i class="fa fa-spinner fa-spin"></i> Loading MCP tool catalog…</td></tr>';

    $.getJSON('/plugins/<?=$plugin?>/include/diagnostics.php?action=get_tool_policy', function(data) {
        umaToolCatalogLoaded = true;
        if (data && Array.isArray(data.tools)) {
            umaToolCatalog = data.tools;
        }
        if (data && data.policies && typeof data.policies === 'object') {
            umaActivePolicies = Object.assign({}, data.policies);
            syncToolPolicyFormInputs();
        }
        populateCategoryFilter();
        renderToolPolicyTable();
        updateCustomPolicyBadge();
    }).fail(function() {
        tbody.innerHTML = '<tr><td colspan="5" style="padding:20px; text-align:center; color:var(--red-500, red);"><i class="fa fa-exclamation-triangle"></i> Failed to load MCP tool catalog. Is the agent service running?</td></tr>';
    });
}

function populateCategoryFilter() {
    var select = document.getElementById('uma-policy-category-filter');
    if (!select) return;
    var categories = {};
    umaToolCatalog.forEach(function(t) {
        if (t.category) categories[t.category] = true;
    });
    var html = '<option value="">All Categories</option>';
    Object.keys(categories).sort().forEach(function(cat) {
        html += '<option value="' + umaEscapeHtml(cat) + '">' + umaEscapeHtml(cat) + '</option>';
    });
    select.innerHTML = html;
}

function renderToolPolicyTable() {
    var tbody = document.getElementById('uma-tool-policy-tbody');
    var search = (document.getElementById('uma-policy-search').value || '').toLowerCase().trim();
    var category = document.getElementById('uma-policy-category-filter').value;
    var typeFilter = document.getElementById('uma-policy-type-filter').value;
    var stateFilter = document.getElementById('uma-policy-state-filter').value;

    var filtered = umaToolCatalog.filter(function(t) {
        if (search && t.name.toLowerCase().indexOf(search) === -1 && (t.description || '').toLowerCase().indexOf(search) === -1) {
            return false;
        }
        if (category && t.category !== category) {
            return false;
        }
        if (typeFilter === 'state_changing' && t.read_only) {
            return false;
        }
        if (typeFilter === 'read_only' && !t.read_only) {
            return false;
        }
        var curPolicy = umaActivePolicies[t.name] || 'default';
        if (stateFilter === 'custom' && curPolicy === 'default') {
            return false;
        }
        if (stateFilter && stateFilter !== 'custom' && curPolicy !== stateFilter) {
            return false;
        }
        return true;
    });

    var stats = document.getElementById('uma-tool-policy-stats');
    if (stats) {
        stats.textContent = 'Showing ' + filtered.length + ' of ' + umaToolCatalog.length + ' tools';
    }

    if (filtered.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" style="padding:20px; text-align:center; color:gray;">No tools match the selected filters.</td></tr>';
        return;
    }

    var html = '';
    filtered.forEach(function(t) {
        var curPolicy = umaActivePolicies[t.name] || 'default';
        var isCustom = curPolicy !== 'default';
        var typeBadge = t.read_only
            ? '<span class="uma-badge uma-badge-read">Read-Only</span>'
            : (t.destructive ? '<span class="uma-badge uma-badge-destructive">Destructive</span>' : '<span class="uma-badge uma-badge-write">Write</span>');

        html += '<tr style="border-bottom:1px solid var(--input-border-color, #eee);">';
        html += '<td style="padding:6px 10px; font-family:monospace; font-weight:bold;">' + umaEscapeHtml(t.name) + '</td>';
        html += '<td style="padding:6px 10px; color:gray;">' + umaEscapeHtml(t.category || 'General') + '</td>';
        html += '<td style="padding:6px 10px;">' + typeBadge + '</td>';
        html += '<td style="padding:6px 10px; font-size:11px; color:inherit; max-width:300px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;" title="' + umaEscapeHtml(t.description || '') + '">' + umaEscapeHtml(t.description || '') + '</td>';
        html += '<td style="padding:6px 10px; text-align:right;">';
        html += '<select class="uma-policy-select' + (isCustom ? ' is-custom' : '') + '" onchange="onToolPolicyChange(\'' + umaEscapeHtml(t.name) + '\', this.value)">';

        var opts = [
            {val: 'default', label: 'Default'},
            {val: 'ask', label: 'Ask (Confirm)'},
            {val: 'allow', label: 'Allow (Immediate)'},
            {val: 'read_only', label: 'Read-Only (Blocked)'},
            {val: 'hidden', label: 'Hidden'}
        ];
        opts.forEach(function(o) {
            var sel = (curPolicy === o.val) ? ' selected' : '';
            html += '<option value="' + o.val + '"' + sel + '>' + o.label + '</option>';
        });
        html += '</select>';
        html += '</td>';
        html += '</tr>';
    });
    tbody.innerHTML = html;
}

function filterToolPolicyTable() {
    renderToolPolicyTable();
}

function onToolPolicyChange(toolName, newValue) {
    if (!newValue || newValue === 'default') {
        delete umaActivePolicies[toolName];
    } else {
        umaActivePolicies[toolName] = newValue;
    }
    syncToolPolicyFormInputs();
    updateCustomPolicyBadge();
    document.getElementById('uma-btn-save-policies').style.display = 'inline-block';
    renderToolPolicyTable();
}

function bulkSetPolicy(scope, policy) {
    umaToolCatalog.forEach(function(t) {
        if (scope === 'write' && t.read_only) return;
        if (!policy || policy === 'default') {
            delete umaActivePolicies[t.name];
        } else {
            umaActivePolicies[t.name] = policy;
        }
    });
    syncToolPolicyFormInputs();
    updateCustomPolicyBadge();
    document.getElementById('uma-btn-save-policies').style.display = 'inline-block';
    renderToolPolicyTable();
}

function syncToolPolicyFormInputs() {
    var jsonInput = document.getElementById('tool_policy_json');
    var csvInput = document.getElementById('tool_policy_val');
    if (jsonInput) jsonInput.value = JSON.stringify(umaActivePolicies);
    if (csvInput) {
        var pairs = [];
        for (var k in umaActivePolicies) {
            if (umaActivePolicies.hasOwnProperty(k) && umaActivePolicies[k] && umaActivePolicies[k] !== 'default') {
                pairs.push(k + '=' + umaActivePolicies[k]);
            }
        }
        csvInput.value = pairs.join(',');
    }
}

function updateCustomPolicyBadge() {
    var count = Object.keys(umaActivePolicies).length;
    var btn = document.getElementById('uma-btn-toggle-policies');
    if (btn) btn.value = 'Configure Tool Policies (' + count + ' customized)';
}

function saveToolPoliciesViaAJAX() {
    var btn = document.getElementById('uma-btn-save-policies');
    var status = document.getElementById('uma-policy-save-status');
    var orig = btn.value;
    btn.disabled = true;
    btn.value = 'Applying…';
    status.style.display = 'inline';
    status.style.color = 'inherit';
    status.textContent = 'Saving policies…';

    $.ajax({
        url: '/plugins/<?=$plugin?>/include/diagnostics.php?action=save_tool_policy',
        type: 'POST',
        data: JSON.stringify({policies: umaActivePolicies}),
        contentType: 'application/json',
        dataType: 'json'
    }).done(function(resp) {
        status.style.color = 'var(--green-500, green)';
        status.textContent = resp.message || 'Applied successfully!';
        setTimeout(function() {
            status.style.display = 'none';
        }, 4000);
    }).fail(function(xhr) {
        status.style.color = 'var(--red-500, red)';
        var msg = (xhr.responseJSON && xhr.responseJSON.error) ? xhr.responseJSON.error : 'Failed to save policies';
        status.textContent = msg;
    }).always(function() {
        btn.disabled = false;
        btn.value = orig;
    });
}

var umaDefaultScheme = <?= json_encode($http_scheme) ?>;
var umaDefaultHost = <?= json_encode($bracketed_addr) ?>;
var umaHasExistingApiToken = <?= json_encode($has_token) ?>;

function getEffectiveMcpBaseUrl() {
    var portInput = document.getElementById('uma_port_input');
    var bindSelect = document.getElementById('uma_bind_select');
    var port = (portInput && portInput.value) ? portInput.value.trim() : '8043';
    var host = umaDefaultHost;
    if (bindSelect && bindSelect.value && bindSelect.value !== '0.0.0.0' && bindSelect.value !== '::') {
        var raw = bindSelect.value.trim();
        host = (raw.indexOf(':') !== -1 && raw.charAt(0) !== '[') ? '[' + raw + ']' : raw;
    }
    return umaDefaultScheme + '://' + host + ':' + port + '/mcp';
}

function getEffectiveMcpSecret() {
    var clearFlag = document.getElementById('clear_mcp_connect_secret');
    if (clearFlag && clearFlag.value === '1') {
        return '';
    }
    var field = document.getElementById('mcp_connect_secret');
    return (field && field.value) ? field.value.trim() : '';
}

function getEffectiveMcpUrl() {
    var base = getEffectiveMcpBaseUrl();
    var secret = getEffectiveMcpSecret();
    if (!secret) {
        return base;
    }
    return base + '/' + secret;
}

function generateMcpConnectSecret() {
    var bytes = new Uint8Array(24);
    window.crypto.getRandomValues(bytes);
    var binary = '';
    for (var i = 0; i < bytes.length; i++) {
        binary += String.fromCharCode(bytes[i]);
    }
    var b64url = window.btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
    var field = document.getElementById('mcp_connect_secret');
    if (!field) return;
    field.value = 'private_' + b64url;
    var genBtn = document.getElementById('uma-btn-mcp-secret-generate');
    if (genBtn) genBtn.value = 'Regenerate';
    var clearFlag = document.getElementById('clear_mcp_connect_secret');
    if (clearFlag) clearFlag.value = '0';
    var clearBtn = document.getElementById('uma-btn-mcp-secret-clear');
    if (clearBtn) clearBtn.style.display = 'inline-block';
    markFieldChanged(field);
    updateMcpOnboardingUI();
}

function clearMcpConnectSecret() {
    var field = document.getElementById('mcp_connect_secret');
    if (field) {
        field.value = '';
        field.placeholder = 'Not configured (standard /mcp endpoint)';
    }
    var genBtn = document.getElementById('uma-btn-mcp-secret-generate');
    if (genBtn) genBtn.value = 'Generate';
    var clearFlag = document.getElementById('clear_mcp_connect_secret');
    if (clearFlag) clearFlag.value = '1';
    var clearBtn = document.getElementById('uma-btn-mcp-secret-clear');
    if (clearBtn) clearBtn.style.display = 'none';
    markFieldChanged(field);
    updateMcpOnboardingUI();
}

function copyTextValue(text, btnEl) {
    if (!text) return;
    var mark = function() {
        if (!btnEl) return;
        var isInput = (btnEl.tagName === 'INPUT');
        var orig = isInput ? btnEl.value : btnEl.innerHTML;
        if (isInput) {
            btnEl.value = 'Copied!';
        } else {
            btnEl.innerHTML = 'Copied!';
        }
        btnEl.disabled = true;
        setTimeout(function() {
            if (isInput) {
                btnEl.value = orig;
            } else {
                btnEl.innerHTML = orig;
            }
            btnEl.disabled = false;
        }, 2000);
    };
    if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(mark).catch(function() {
            fallbackCopyRaw(text, mark);
        });
    } else {
        fallbackCopyRaw(text, mark);
    }
}

function fallbackCopyRaw(text, callback) {
    var ta = document.createElement('textarea');
    ta.value = text;
    ta.style.position = 'fixed';
    ta.style.left = '-9999px';
    document.body.appendChild(ta);
    ta.select();
    try {
        if (document.execCommand('copy') && callback) callback();
    } catch (e) {
        // ignore
    }
    ta.remove();
}

function copyMcpConnectUrl(btnEl) {
    var url = getEffectiveMcpUrl();
    var btn = btnEl || document.getElementById('uma-btn-mcp-url-copy');
    copyTextValue(url, btn);
}

function updateMcpOnboardingUI() {
    var baseUrl = getEffectiveMcpBaseUrl();
    var secret = getEffectiveMcpSecret();
    var directItem = document.getElementById('uma-mcp-direct-url-item');
    var directLink = document.getElementById('uma-mcp-direct-url-link');
    if (directItem) {
        directItem.style.display = secret ? 'list-item' : 'none';
    }
    if (directLink && secret) {
        var fullUrl = baseUrl + '/' + secret;
        directLink.textContent = fullUrl;
    }
    var stdLink = document.getElementById('uma-mcp-standard-url-link');
    if (stdLink) {
        stdLink.textContent = baseUrl;
    }
    var endpointSpan = document.getElementById('uma-mcp-endpoint-url');
    if (endpointSpan) {
        endpointSpan.textContent = baseUrl;
    }
    var tokenInput = document.getElementById('api_token');
    var tokenCleared = document.getElementById('api_token_clear') && document.getElementById('api_token_clear').value === '1';
    var hasApiToken = (!tokenCleared && (umaHasExistingApiToken || (tokenInput && tokenInput.value.trim() !== '')));
    var stdLabel = document.getElementById('uma-mcp-standard-url-label');
    if (stdLabel) {
        stdLabel.textContent = hasApiToken ? '(Bearer token)' : '(standard endpoint)';
    }
    var noTokenBanner = document.getElementById('uma-mcp-no-token-warning');
    if (noTokenBanner) {
        noTokenBanner.style.display = (secret && !hasApiToken) ? 'block' : 'none';
    }
}

$(function() {
    updateDisabledHighlighting();
    document.querySelectorAll('.uma-interval-select').forEach(function(select) {
        select.addEventListener('change', updateDisabledHighlighting);
    });
    updateTokenButtons();
    updateMcpOnboardingUI();
});
</script>
