// Load current configuration
$config = [];
if (file_exists($config_file)) {
    $config = parse_ini_file($config_file, false, INI_SCANNER_RAW);
}

// Default values
$port = $config['PORT'] ?? '8043';
$bind_address = $config['BIND_ADDRESS'] ?? '';
$api_token = trim((string)($config['API_TOKEN'] ?? ''), " \t\n\r\0\x0B'\"");
$mcp_connect_secret = preg_replace('/[^A-Za-z0-9_-]/', '', (string)($config['MCP_CONNECT_SECRET'] ?? ''));
$tls_cert_file = $config['TLS_CERT_FILE'] ?? '';
$tls_key_file = $config['TLS_KEY_FILE'] ?? '';
$read_only = $config['READ_ONLY'] ?? 'false';
$log_level = $config['LOG_LEVEL'] ?? 'info';

// MCP Tool Policies
$policy_file = "/boot/config/plugins/$plugin/tool_policy.json";
$tool_policies = [];
if (file_exists($policy_file)) {
    $tool_policies = json_decode(file_get_contents($policy_file), true) ?: [];
}
$tool_policy_cfg = $config['TOOL_POLICY'] ?? '';
if (!file_exists($policy_file) && !empty($tool_policy_cfg)) {
    $pairs = explode(',', $tool_policy_cfg);
    $allowed_policies = ['default', 'hidden', 'read_only', 'allow', 'ask'];
    foreach ($pairs as $p) {
        $kv = explode('=', trim($p), 2);
        if (count($kv) === 2) {
            $tool = trim($kv[0]);
            $pol = trim($kv[1]);
            if (preg_match('/^[a-zA-Z0-9_.-]+$/', $tool) && in_array($pol, $allowed_policies, true) && $pol !== 'default') {
                $tool_policies[$tool] = $pol;
            }
        }
    }
}
$tool_policy_json = json_encode((object)$tool_policies);


// MQTT defaults
$mqtt_enabled = $config['MQTT_ENABLED'] ?? 'false';
$mqtt_broker = $config['MQTT_BROKER'] ?? '';
$mqtt_port = $config['MQTT_PORT'] ?? '1883';
$mqtt_username = $config['MQTT_USERNAME'] ?? '';
$mqtt_password = $config['MQTT_PASSWORD'] ?? '';
$mqtt_topic_prefix = $config['MQTT_TOPIC_PREFIX'] ?? 'unraid';
$mqtt_ha_enabled = $config['MQTT_HOME_ASSISTANT'] ?? 'false';

// Collection interval defaults
$interval_system = $config['INTERVAL_SYSTEM'] ?? '15';
$interval_array = $config['INTERVAL_ARRAY'] ?? '60';
$interval_disk = $config['INTERVAL_DISK'] ?? '300';
$interval_docker = $config['INTERVAL_DOCKER'] ?? '30';
$interval_vm = $config['INTERVAL_VM'] ?? '60';
$interval_ups = $config['INTERVAL_UPS'] ?? '60';
$interval_nut = $config['INTERVAL_NUT'] ?? '0';
$interval_gpu = $config['INTERVAL_GPU'] ?? '60';
$interval_shares = $config['INTERVAL_SHARES'] ?? '60';
$interval_network = $config['INTERVAL_NETWORK'] ?? '60';
$interval_zfs = $config['INTERVAL_ZFS'] ?? '0';
$interval_notification = $config['INTERVAL_NOTIFICATION'] ?? '30';
$interval_hardware = $config['INTERVAL_HARDWARE'] ?? '600';
$interval_registration = $config['INTERVAL_REGISTRATION'] ?? '600';
$interval_unassigned = $config['INTERVAL_UNASSIGNED'] ?? '60';
$interval_storage_topology = $config['INTERVAL_STORAGE_TOPOLOGY'] ?? '300';

// Check if service is running
exec("pidof $plugin 2>/dev/null", $pids, $pid_rc);
$running = ($pid_rc === 0 && !empty($pids));

// Enumerate local interface IPs for the bind address dropdown. Skips
// loopback, link-local, and container/VM bridge interfaces (docker,
// br-<hash>, virbr, veth) — binding there would hide the agent from
// integrations such as Home Assistant.
function localBindIPs() {
    // Absolute path: php-fpm's PATH does not include /usr/sbin.
    $ip_bin = is_executable('/usr/sbin/ip') ? '/usr/sbin/ip' : '/sbin/ip';
    // Non-numeric keys: PHP casts numeric string keys ('4') to int, which
    // breaks strict comparisons against the loop key.
    $commands = [
        'v4' => "$ip_bin -4 addr show 2>/dev/null",
        'v6' => "$ip_bin -6 addr show 2>/dev/null",
    ];
    $result = [];
    $seen = [];
    foreach ($commands as $family => $command) {
        $output = @shell_exec($command);
        if (!$output) {
            continue;
        }
        $iface = '';
        foreach (explode("\n", trim($output)) as $line) {
            if (preg_match('/^\d+:\s+(\S+):/', $line, $m)) {
                $iface = explode('@', $m[1])[0]; // br0.40@br0 -> br0.40
            }
            if ($iface !== '' && preg_match('/^(docker|br-[0-9a-f]{12}|virbr|veth|lo$)/', $iface)) {
                continue;
            }
            if ($family === 'v4') {
                if (!preg_match('/inet\s+([0-9.]+)\//', $line, $m) || strpos($m[1], '127.') === 0) {
                    continue;
                }
            } else {
                if (!preg_match('/inet6\s+([0-9a-fA-F:]+)\//', $line, $m) || strtolower($m[1]) === '::1') {
                    continue;
                }
                if (stripos($m[1], 'fe80:') === 0) {
                    continue;
                }
                if (!filter_var($m[1], FILTER_VALIDATE_IP, FILTER_FLAG_IPV6)) {
                    continue;
                }
            }
            $key = $family . ':' . strtolower($m[1]);
            if (isset($seen[$key])) {
                continue;
            }
            $seen[$key] = true;
            $result[] = ['ip' => $m[1], 'iface' => $iface];
        }
    }
    return $result;
}

// Build the bind address <option> list from the detected interface IPs.
$bind_options = '<option value="">All interfaces (default)</option>';
$bind_known = [''];
foreach (localBindIPs() as $nic) {
    $ip_esc = htmlspecialchars($nic['ip'], ENT_QUOTES, 'UTF-8');
    $iface_esc = htmlspecialchars($nic['iface'], ENT_QUOTES, 'UTF-8');
    $sel = ($bind_address === $nic['ip']) ? ' selected' : '';
    $bind_options .= "<option value=\"$ip_esc\"$sel>$ip_esc ($iface_esc)</option>";
    $bind_known[] = $nic['ip'];
}
if (!in_array($bind_address, $bind_known, true)) {
    // Saved address no longer exists (e.g. VLAN removed) — show it so the
    // selection is honest; apply resets it to all interfaces server-side.
    $stale_esc = htmlspecialchars($bind_address, ENT_QUOTES, 'UTF-8');
    $bind_options .= "<option value=\"$stale_esc\" selected>$stale_esc (not detected — resets to all interfaces)</option>";
}

// Helper function to generate interval select options
function intervalOptions($selected, $type = 'standard') {
    $options = [];
    $extended = [
        '3600' => '1 hour',
        '7200' => '2 hours',
        '14400' => '4 hours',
        '21600' => '6 hours',
        '43200' => '12 hours',
        '86400' => '24 hours',
    ];
    if ($type === 'fast') {
        $options = [
            '0' => 'Disabled',
            '5' => '5 seconds',
            '10' => '10 seconds',
            '15' => '15 seconds',
            '30' => '30 seconds',
            '60' => '1 minute',
            '120' => '2 minutes',
            '300' => '5 minutes',
            '600' => '10 minutes',
            '900' => '15 minutes',
            '1800' => '30 minutes',
        ] + $extended;
    } elseif ($type === 'standard') {
        $options = [
            '0' => 'Disabled',
            '10' => '10 seconds',
            '15' => '15 seconds',
            '30' => '30 seconds',
            '60' => '1 minute',
            '120' => '2 minutes',
            '300' => '5 minutes',
            '600' => '10 minutes',
            '900' => '15 minutes',
            '1800' => '30 minutes',
        ] + $extended;
    } elseif ($type === 'slow') {
        $options = [
            '0' => 'Disabled',
            '60' => '1 minute',
            '120' => '2 minutes',
            '300' => '5 minutes',
            '600' => '10 minutes',
            '900' => '15 minutes',
            '1800' => '30 minutes',
        ] + $extended;
    }
    $html = '';
    foreach ($options as $value => $label) {
        $isSelected = ($selected == $value) ? 'selected' : '';
        $html .= "<option value=\"$value\" $isSelected>$label</option>";
    }
    return $html;
}
