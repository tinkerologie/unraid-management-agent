<?xml version='1.0' standalone='yes'?>

<!DOCTYPE PLUGIN [
    <!ENTITY name        "unraid-management-agent">
    <!ENTITY author      "Ruaan Deysel">
    <!ENTITY version     "2026.11.00">
    <!ENTITY gitURL      "https://github.com/tinkerologie/&name;">
    <!ENTITY pluginURL   "&gitURL;/raw/main/&name;.plg">
    <!ENTITY supportURL  "https://forums.unraid.net/topic/196675-plugin-unraid-management-agent">
    <!ENTITY launch      "Settings/unraid-management-agent">
    <!ENTITY bundle      "&name;-&version;.tgz">
    <!ENTITY bundleURL   "&gitURL;/releases/download/v&version;/&bundle;">
    <!ENTITY md5         "b7ce8a6ae956a0df776c77803f1e57c6"> <!-- pragma: allowlist secret -->
    <!ENTITY sha256      "f3394e32ef79a01ccf98a1bba6bc86e0595c583be60d1d61f643e0c61361e31a"> <!-- pragma: allowlist secret -->
]>

<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;" icon="server" min="7.2.0" pluginURL="&pluginURL;" support="&supportURL;" project="&gitURL;" readme="&gitURL;#readme">

<DESCRIPTION>
Monitor and control your Unraid system via REST API, WebSocket, MCP, Prometheus, and MQTT. Supports Docker/VM control, real-time metrics, Home Assistant integration, and AI agent tooling.
</DESCRIPTION>

<CHANGES>
### 2026.11.00

### Fixed

- CPU usage now uses one `/proc/stat` snapshot per collection for aggregate and per-core readings,
  without sampling sleeps (#298). Readings cover the interval since the previous successful collection;
  the first reading is the since-boot average. Counter resets and decreases are handled safely,
  and zero deltas retain the previous reading and baseline.
- VM telemetry now reports guest memory usage, then QEMU RSS, then zero for running VMs,
  and zero for non-running VMs (#295). The Home Assistant "Memory Used" sensor now shows
  real or zero usage instead of allocated memory. Primary disk source and guest-visible virtual
  capacity are collected best effort through native libvirt for all VM states.
- Read disk filesystem, spin state, boot flash role and filesystem capacity from `disks.ini` (#296).
  Use `fsType` rather than partition format and `spundown` rather than temperature or device probes.
  Preserve KiB-based `fsFree`/`fsUsed`/`fsSize`, including zero free space, without statfs or ZFS overrides;
  use `fsSize` for ZFS pool totals and for other filesystems when used plus free exceeds physical size.
  Keep existing capacity fallbacks for disks without valid `fsFree`. Boot flash reports role `flash` and
  its own Prometheus `Flash` type label. Source-field collection performs no disk-waking queries.
- Separate share content from backing-storage usage (#293): add `storage_used_bytes`,
  `storage_free_bytes`, `storage_total_bytes` and `storage_usage_percent`; retain
  `free_bytes`, `total_bytes` and `usage_percent` as deprecated storage aliases.
  `used_bytes` is now omitted unless measured from the assigned, cache-only ZFS pool
  with every member known spinning. Include only mounted descendant filesystems at or beneath
  the share dataset's mountpoint, without directory walks; omit usage when mount metadata is unknown.
  Refresh spin state before each pool query and after queries before checking share locations.
  Prometheus omits unknown share usage and adds storage gauges; Home Assistant discovery
  labels storage readings explicitly and preserves unknown versus measured-zero usage.

- Container memory usage now excludes the `inactive_file` page cache from cgroup v2
  `memory.current`, clamped at zero. Missing or malformed `memory.stat` falls back to raw usage;
  memory percentages, displays and aggregates use the corrected value (#294).
- **Sensor plausibility and unknown measurements** (#297): apply a 100 °C ceiling only to `SYSTIN`
  and `AUXTIN*` temperature labels, and drop readings at or below 0 °C only for PECI and DIMM labels.
  Other labels retain the global −40 °C &lt; reading &lt; 125 °C range. AUXTIN VRM readings above
  100 °C are hidden as a trade-off. Implausible fan channels are quarantined for 15 minutes
  after their last bad sample, with stable names and no fan DTO or safety/control-policy changes.
- Unmeasured `motherboard_temp_celsius`, disk `temperature_celsius`, and GPU `temperature_celsius`,
  `power_draw_watts`, `memory_total_bytes`, `memory_used_bytes` and `utilization_memory_percent`
  now serialize as JSON `null` with keys retained (`x-nullable`), following UPS/NUT. Measured zeros
  remain numbers. MQTT/Home Assistant numeric sensors render `None`; Prometheus omits and removes
  unavailable series; health checks and MCP do not treat missing temperature as measured 0.
  Alert variables `MotherboardTemp`, `MaxDiskTemp`, `MaxGPUTemp` and `TotalGPUPower` are nullable:
  guard rules with `!= nil`. Unguarded nil evaluations preserve alert state and log the failure once.
  Disk-temperature trends exclude unavailable readings; history expires after one hour even
  without new measurements.
- Intel GPU temperature and driver metadata are read from the detected PCI device. `driver_version`
  reports the bound driver name (`i915` or `xe`) plus the module version when available, replacing
  the unrelated kernel vermagic value. CPU temperature is kept separate from GPU temperature.

- Disks whose `smartctl` exit status has only informational bits set no longer report
  `smart_status: "UNKNOWN"` without attributes, and `system_health_report` no longer calls them
  a critical SMART failure (#292). The exit status is decoded as a bitmask and exposed as
  `smart_exit_status`. A disk with a pre-fail attribute at threshold now gets a warning, historic
  records and an unreadable (`UNKNOWN`) status get an info finding.

### Added

- **MCP tool policy panel** (#307) — an **All → Hidden** button, so you can hide every tool and then
  re-enable only the ones you want. Tool descriptions now show in full, without hovering.
- **Endpoint toggles** (#273) — `mcp_enabled`, `metrics_enabled` and `websocket_enabled`, each
  available as a CLI flag, an environment variable, a `config.yml` key and a switch on the plugin
  settings page. All default to on. A disabled endpoint returns 404 and does no background work, so
  the agent can run as REST only. These switches limit exposure; they
  are unlikely to lower CPU usage much.
- Shared read-only PSU collector with exact-ID auto-detection for Corsair RMi/HXi USB PSUs
  through the kernel `corsairpsu` hwmon interface (part of #61). Includes hardware gating,
  independent hotplug inventory, Dynamic/Manual configuration and plugin settings, explicit
  availability and nullable readings, derived DC load, REST/WebSocket/MCP, MQTT/Home Assistant
  discovery, and Prometheus. Bounded, ordered discovery keeps slow MQTT brokers from blocking
  other telemetry; regression tests cover startup delivery, cancellation and recovery.
  The PSU endpoint is grouped with hardware monitoring routes.
  AXi and other vendor backends remain separate follow-up work.
- PSU telemetry feasibility research for #61, #194, #195, #196 and #197, covering
  model-specific interfaces, automatic discovery, implementation phases and validation requirements.
  This documents proposed work; it does not add runtime PSU monitoring.

### Changed

- `GET /api/v1/settings/network-services` now scans `/proc` once per request instead of once per service
  (#306). The response is unchanged.

### Security

- Require Go 1.27.3 for builds to include the `crypto/x509` intermediate-certificate distrust
  update ([GO-2026-6809](https://pkg.go.dev/vuln/GO-2026-6809)), found during PSU validation.
</CHANGES>

<!--
Unraid Management Agent - REST API and WebSocket server for comprehensive system monitoring and control.

This plugin provides a REST API and WebSocket interface for monitoring and controlling your Unraid server.
Perfect for Home Assistant integration, custom dashboards, or automation scripts.

Features:
- 20+ REST API endpoints
- Real-time WebSocket events
- Docker and VM control
- System monitoring (CPU, RAM, temps, fans, disks)
- Array management
- Parity check control
- UPS and GPU monitoring
- Secure input validation
- Automatic log rotation

Requirements:
- Unraid 6.9+ (tested on Unraid 7.x)
- Port 8043 available (configurable)

Support:
- GitHub Issues: https://github.com/tinkerologie/unraid-management-agent/issues
- Documentation: https://github.com/tinkerologie/unraid-management-agent/blob/main/README.md
-->

<!-- Verify Unraid version compatibility -->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
#!/bin/bash

# Check Unraid version compatibility
if [ -f /etc/unraid-version ]; then
    source /etc/unraid-version

    # Extract major and minor version numbers
    major_version=$(echo "$version" | cut -d'.' -f1)
    minor_version=$(echo "$version" | cut -d'.' -f2)

    # Check if version is at least 6.9.0
    if [ "$major_version" -lt 6 ] || ([ "$major_version" -eq 6 ] && [ "$minor_version" -lt 9 ]); then
        echo ""
        echo "========================================="
        echo " ERROR: Incompatible Unraid Version"
        echo "========================================="
        echo ""
        echo "This plugin requires Unraid 6.9.0 or higher."
        echo "Your current version: $version"
        echo ""
        echo "Please upgrade your Unraid system before installing this plugin."
        echo ""
        exit 1
    fi

    echo "✓ Unraid version check passed (version: $version)"
else
    echo "⚠ Warning: Could not verify Unraid version"
    echo "  Proceeding with installation..."
fi

exit 0
]]>
</INLINE>
</FILE>

<!-- Download the plugin bundle -->
<FILE Name="/boot/config/plugins/&name;/&bundle;">
<URL>&bundleURL;</URL>
<MD5>&md5;</MD5>
<SHA256>&sha256;</SHA256>
</FILE>

<!-- Install default configuration -->
<FILE Name="/boot/config/plugins/&name;/config.cfg">
<INLINE>
<![CDATA[
# Unraid Management Agent Configuration
# This file is automatically created if it doesn't exist

# Service configuration
SERVICE="enable"

# API Server Configuration
PORT="8043"
ENABLE_CORS="yes"

# Collection mode - dynamic lets the agent decide when each collector runs,
# manual uses the intervals below
COLLECTION_MODE="dynamic"

# Collection intervals (seconds) - Power-optimized defaults
# Higher intervals reduce CPU wakeups and power consumption
# Set any interval to 0 to disable that collector
INTERVAL_SYSTEM="15"
INTERVAL_ARRAY="30"
INTERVAL_DISK="30"
INTERVAL_DOCKER="30"
INTERVAL_VM="30"
INTERVAL_UPS="auto"
INTERVAL_GPU="auto"
INTERVAL_SHARES="60"
INTERVAL_NETWORK="30"
INTERVAL_ZFS="auto"
INTERVAL_NOTIFICATION="30"
INTERVAL_HARDWARE="300"
INTERVAL_REGISTRATION="300"
INTERVAL_UNASSIGNED="60"
INTERVAL_NUT="auto"
INTERVAL_STORAGE_TOPOLOGY="auto"
INTERVAL_NIC="auto"
INTERVAL_PSU="auto"
INTERVAL_FAN_CONTROL="60"
INTERVAL_TUNING="120"
INTERVAL_DOCKER_UPDATE="21600"
INTERVAL_DOCKER_NETWORKS="60"
INTERVAL_PLUGIN_UPDATE="3600"
INTERVAL_OS_UPDATE="86400"
INTERVAL_MOVER="30"
]]>
</INLINE>
</FILE>

<!-- Installation script -->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
#!/bin/bash

PLUGIN_NAME="unraid-management-agent"
CONFIG_DIR="/boot/config/plugins/${PLUGIN_NAME}"
INSTALL_DIR="/usr/local/emhttp/plugins/${PLUGIN_NAME}"

# Find the downloaded bundle and extract version from filename
BUNDLE=$(ls ${CONFIG_DIR}/${PLUGIN_NAME}-*.tgz 2>/dev/null | sort -V | tail -n 1)
if [ -z "$BUNDLE" ]; then
    echo "✗ Error: No plugin bundle found in ${CONFIG_DIR}"
    exit 1
fi

# Extract version from bundle filename (e.g., unraid-management-agent-2025.11.2.tgz -> 2025.11.2)
VERSION=$(basename "$BUNDLE" .tgz | sed "s/${PLUGIN_NAME}-//")

echo ""
echo "========================================="
echo " Installing ${PLUGIN_NAME}"
echo " Version: ${VERSION}"
echo "========================================="
echo ""

# Check if service is running
running=$(pidof ${PLUGIN_NAME} | wc -w)

# Stop service if running
if [ $running -ge 1 ]; then
    echo "Stopping existing service..."
    killall ${PLUGIN_NAME} 2>/dev/null
    sleep 2
fi

# Remove old plugin files
echo "Removing old plugin files..."
rm -rf ${INSTALL_DIR}/* 2>/dev/null
mkdir -p ${INSTALL_DIR}

# Remove old bundle files (keep current version)
echo "Cleaning up old bundles..."
rm -f $(ls ${CONFIG_DIR}/${PLUGIN_NAME}*.tgz 2>/dev/null | grep -v "${VERSION}.tgz")

# Extract the bundle
echo "Extracting plugin bundle..."
if [ -f "${BUNDLE}" ]; then
    # Never take owners from the archive or rewrite existing system directories (#242)
    tar --no-same-owner --no-overwrite-dir -xzf "${BUNDLE}" -C / 2>&1
    TAR_EXIT=$?
    if [ $TAR_EXIT -eq 0 ]; then
        echo "✓ Bundle extracted successfully"
    else
        echo "✗ Failed to extract bundle (exit code: $TAR_EXIT)"
        exit 1
    fi
else
    echo "✗ Bundle not found: ${BUNDLE}"
    exit 1
fi

# Restore root ownership that earlier bundles set on shared directories (#242)
for DIR in /usr /usr/local /usr/local/emhttp /usr/local/emhttp/plugins "${INSTALL_DIR}"; do
    if [ -d "$DIR" ] && [ "$(stat -c '%u:%g' "$DIR")" != "0:0" ]; then
        if chown root:root "$DIR"; then
            echo "✓ Restored root ownership of ${DIR}"
        else
            echo "⚠ Could not restore root ownership of ${DIR}"
        fi
    fi
done

# Set executable permissions
echo "Setting permissions..."
chmod +x ${INSTALL_DIR}/${PLUGIN_NAME} 2>/dev/null
chmod +x ${INSTALL_DIR}/scripts/* 2>/dev/null
chmod +x ${INSTALL_DIR}/event/* 2>/dev/null

# Verify installation
if [ -f "${INSTALL_DIR}/${PLUGIN_NAME}" ]; then
    echo "✓ Binary installed"
else
    echo "✗ Binary not found after installation"
    exit 1
fi

# Keep network write access for existing installs without an API token (#245).
# A failure leaves the install on the secure default, so it does not abort.
# The marker is set only when the migration succeeds (it exits 0 for fresh
# installs too), so a failed migration is retried on the next upgrade.
if "${INSTALL_DIR}/scripts/migrate-secure-defaults"; then
    touch "${CONFIG_DIR}/.secure-defaults-migrated"
else
    echo "⚠ Secure-defaults migration failed; set an API token to re-enable control actions"
fi

# Switch hardware-dependent collectors left on a shipped default to "auto" (#261).
# The marker is set only on success, so a failed migration is retried.
if "${INSTALL_DIR}/scripts/migrate-auto-intervals"; then
    touch "${CONFIG_DIR}/.auto-intervals-migrated"
else
    echo "⚠ Auto-interval migration failed; hardware collectors keep their saved intervals"
fi

# Move existing installs whose intervals are all shipped defaults to dynamic
# collection; tuned installs stay on manual (#280). Runs after the auto-interval
# migration so its "auto" values count as defaults. The marker is set only on
# success (the script exits 0 for fresh installs too), so a failure is retried.
if "${INSTALL_DIR}/scripts/migrate-collection-mode"; then
    touch "${CONFIG_DIR}/.collection-mode-migrated"
else
    echo "⚠ Collection-mode migration failed; the agent keeps using the manual intervals"
fi

# Start service if it was running before, or if this is a fresh install
if [ $running -ge 1 ] || [ ! -f "${CONFIG_DIR}/.installed" ]; then
    echo "Starting service..."
    ${INSTALL_DIR}/scripts/start
    sleep 2

    # Verify service started
    if pidof ${PLUGIN_NAME} > /dev/null; then
        echo "✓ Service started successfully"
    else
        echo "⚠ Service may not have started. Check logs: /var/log/${PLUGIN_NAME}.log"
    fi
fi

# Mark as installed
touch ${CONFIG_DIR}/.installed

echo ""
echo "========================================="
echo " ${PLUGIN_NAME} v${VERSION}"
echo " Installation Complete!"
echo "========================================="
echo ""
echo "API Server: http://localhost:8043"
echo "Configuration: ${CONFIG_DIR}/config.cfg"
echo "Logs: /var/log/${PLUGIN_NAME}.log"
echo ""
echo "For documentation and support:"
echo "  https://github.com/tinkerologie/unraid-management-agent"
echo ""
]]>
</INLINE>
</FILE>

<!-- Removal script -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
#!/bin/bash

PLUGIN_NAME="unraid-management-agent"
INSTALL_DIR="/usr/local/emhttp/plugins/${PLUGIN_NAME}"
CONFIG_DIR="/boot/config/plugins/${PLUGIN_NAME}"
LOG_FILE="/var/log/${PLUGIN_NAME}.log"

# Try to extract version from bundle filename, fallback to "unknown" if not found
BUNDLE=$(ls ${CONFIG_DIR}/${PLUGIN_NAME}-*.tgz 2>/dev/null | sort -V | tail -n 1)
if [ -n "$BUNDLE" ]; then
    VERSION=$(basename "$BUNDLE" .tgz | sed "s/${PLUGIN_NAME}-//")
else
    VERSION="unknown"
fi

echo ""
echo "========================================="
echo " Removing ${PLUGIN_NAME}"
echo " Version: ${VERSION}"
echo "========================================="
echo ""

# Stop the service
echo "Stopping service..."
if [ -f "${INSTALL_DIR}/scripts/stop" ]; then
    ${INSTALL_DIR}/scripts/stop
else
    killall ${PLUGIN_NAME} 2>/dev/null
fi
sleep 2

# Verify service stopped
if pidof ${PLUGIN_NAME} > /dev/null; then
    echo "Force stopping service..."
    killall -9 ${PLUGIN_NAME} 2>/dev/null
    sleep 1
fi

# Final verification
if pidof ${PLUGIN_NAME} > /dev/null; then
    echo "✗ Warning: Service may still be running"
else
    echo "✓ Service stopped"
fi

echo ""
echo "Removing all plugin files and data..."
echo ""

# Remove plugin installation directory
if [ -d "${INSTALL_DIR}" ]; then
    rm -rf ${INSTALL_DIR}
    if [ $? -eq 0 ]; then
        echo "✓ Removed plugin directory: ${INSTALL_DIR}"
    else
        echo "✗ Failed to remove: ${INSTALL_DIR}"
    fi
else
    echo "  Plugin directory not found (already removed)"
fi

# Remove configuration directory
if [ -d "${CONFIG_DIR}" ]; then
    rm -rf ${CONFIG_DIR}
    if [ $? -eq 0 ]; then
        echo "✓ Removed configuration directory: ${CONFIG_DIR}"
    else
        echo "✗ Failed to remove: ${CONFIG_DIR}"
    fi
else
    echo "  Configuration directory not found (already removed)"
fi

# Remove log file
if [ -f "${LOG_FILE}" ]; then
    rm -f ${LOG_FILE}
    if [ $? -eq 0 ]; then
        echo "✓ Removed log file: ${LOG_FILE}"
    else
        echo "✗ Failed to remove: ${LOG_FILE}"
    fi
else
    echo "  Log file not found (already removed)"
fi

echo ""
echo "========================================="
echo " Complete Removal Successful"
echo "========================================="
echo ""
echo "All plugin files and data have been removed from the system."
echo ""
]]>
</INLINE>
</FILE>

</PLUGIN>
