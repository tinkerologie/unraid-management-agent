# Ansible inventory for Unraid Management Agent deployment
# Copy to inventory.yml and update with your server details:
#   cp ansible/inventory.yml.example ansible/inventory.yml
#
# IMPORTANT: inventory.yml is in .gitignore and will NOT be committed to git

all:
  hosts:
    unraid:
      ansible_host: 192.168.1.100
      ansible_user: root
      ansible_ssh_private_key_file: ~/.ssh/id_ed25519
      # ansible_port: 22
      # uma_known_hosts_file: ~/.ssh/known_hosts
      # SSH options come from group_vars/all.yml; remove old inventory overrides.
      api_port: 8043
      # API token the deploy role writes to config.cfg and the verify role sends.
      # Required for the write tests: without a token the agent refuses network
      # writes. Generate one with: openssl rand -hex 32
      api_token: "your-64-hex-char-token"
